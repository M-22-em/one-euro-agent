# Only deliberately selected public files belong in this repository.
/*
!/.gitignore
!/README.md
!/MISSION.md
!/docs/
!/examples/
/docs/*
!/docs/architecture.md
!/docs/public-status.md
/examples/*
!/examples/queued-message-regression.md

# Public audited integrations and workflows.
!/.github/
!/integrations/
!/docs/marketplace-runbook.md
!/docs/circadian-adaptation.md
!/docs/operator-view.md
!/docs/circadian-import.json
# Never stage private runtime state or credentials.
**/node_modules/
**/.env
**/.env.*
**/*.local.json
**/.taskmarket-mcp-spend.json
**/keystore.json
**/*.pem
**/wallets/
**/private/
